  { "id": "txt:read-dlg-greeting", "kind": "text", "textType": "dialogue", "source": "m20",
    "vowelled": "السَّلَامُ عَلَيْكُمْ — وَعَلَيْكُمُ السَّلَامُ — كَيْفَ حَالُكَ؟ — أَنَا بِخَيْرٍ، شُكْرًا",
    "translit": "as-salāmu ʿalaykum — wa-ʿalaykumu s-salāmu — kayfa ḥāluka? — anā bikhayrin, shukran",
    "en": "— Peace be upon you. — And upon you be peace. — How are you? — I'm fine, thank you.",
    "turns": [
      { "ar": "السَّلَامُ عَلَيْكُمْ", "translit": "as-salāmu ʿalaykum", "en": "Peace be upon you." },
      { "ar": "وَعَلَيْكُمُ السَّلَامُ", "translit": "wa-ʿalaykumu s-salāmu", "en": "And upon you be peace." },
      { "ar": "كَيْفَ حَالُكَ؟", "translit": "kayfa ḥāluka?", "en": "How are you?" },
      { "ar": "أَنَا بِخَيْرٍ، شُكْرًا", "translit": "anā bikhayrin, shukran", "en": "I'm fine, thank you." }
    ],
    "audio": "السَّلَامُ عَلَيْكُمْ. وَعَلَيْكُمُ السَّلَامُ. كَيْفَ حَالُكَ؟ أَنَا بِخَيْرٍ، شُكْرًا.",
    "level": "A1", "skills": [ "listening", "reading", "comprehension" ],
    "prereqs": [ "gr:nominal-sentence" ] },

  { "id": "txt:read-dlg-name", "kind": "text", "textType": "dialogue", "source": "m20",
    "vowelled": "مَا اسْمُكِ؟ — اسْمِي سَارَةُ — تَشَرَّفْنَا",
    "translit": "mā ismuki? — ismī sāratu — tasharrafnā",
